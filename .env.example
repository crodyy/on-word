# Copy this file to .env.local and fill in the values.
# .env.local is gitignored. Never commit real values, never paste them into chat.
# Server-only: WORLD_*, RP_SIGNING_KEY, ARKIV_*, SPONSOR_*, REGISTRY_PATH.
# Never prefix secrets with NEXT_PUBLIC_.

# World Developer Portal (https://developer.world.org)
WORLD_APP_ID=
WORLD_RP_ID=
# Shown once when the RP is created. Save it immediately.
RP_SIGNING_KEY=
# Must match the action name created in the portal exactly
WORLD_ACTION_REGISTER=human-forum-register-v1
# staging for the simulator, production for real phones. Must match the action.
WORLD_ENVIRONMENT=staging

# Arkiv (https://docs.arkiv.network/)
# Free key from Arkiv Hub
ARKIV_ACCESS_KEY=
# Throwaway testnet wallet only, funded with tGLM. Never a real wallet.
SPONSOR_PRIVATE_KEY=

# Local file state (gitignored under data/). Used ONLY when no shared KV is
# configured. Set REGISTRY_PATH only to point tests or local dev at a scratch
# file; the rate-limit paths double as quota bucket names when KV is on.
REGISTRY_PATH=./data/registry.json

# Vercel KV / Upstash Redis (serverless shared state). Link a store in
# Vercel Dashboard -> Storage, or set these manually AND in Vercel
# Settings -> Environment Variables, then redeploy. Without them the app
# silently falls back to per-instance files: registry bindings, nonces,
# rate limits, and the feed cache are lost across instances.
#KV_REST_API_URL=
#KV_REST_API_TOKEN=

# TEMP-DEMO (T-035): open access for time-pressed testing. When true the
# server skips World ID registry checks: reads show every sponsor post and
# writes need only a fresh wallet signature (still key-attributed, still
# rate-limited). Default off. Set it in Vercel Settings -> Environment
# Variables too, then redeploy. Remove before any real launch.
#DEMO_OPEN_ACCESS=true

# Public client values for the IDKit widget (safe for NEXT_PUBLIC_; rp_id and
# action are visible in every proof request anyway). Mirror the server values.
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_RP_ID=
NEXT_PUBLIC_WORLD_ACTION=human-forum-register-v1
NEXT_PUBLIC_WORLD_ENVIRONMENT=staging
